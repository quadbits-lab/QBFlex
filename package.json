{
  "name": "qb-flex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run test && bun scripts/generated-types-check.ts && bun scripts/docs-examples.ts && bun scripts/contracts-check.ts && bun run docs:check",
    "docs:generate": "bun scripts/docs.ts",
    "docs:check": "bun scripts/docs.ts --check",
    "sdk:build": "bun scripts/sdk-build.ts",
    "sdk:pack": "bun scripts/sdk-pack.ts",
    "skill:refresh": "bun scripts/skill.ts refresh",
    "skill:check": "bun scripts/skill.ts check",
    "skill:test": "bun scripts/skill-test.ts",
    "skill:pack": "bun scripts/skill.ts pack",
    "spike": "bun scripts/spike.ts",
    "seed": "bun scripts/seed.ts",
    "qb": "bun apps/cli/src/index.ts",
    "test:integration": "QB_INTEGRATION_STORAGE=1 bun test tests/integration",
    "test:browser": "bun scripts/browser-check.ts",
    "test:cli": "bun scripts/cli-check.ts",
    "test:compose": "bun scripts/compose-check.ts",
    "verify:linux": "docker build -f infra/Dockerfile --target verify -t qb-flex-verified .",
    "test:upload-queue": "bun scripts/upload-queue-check.ts",
    "test:studio-auth": "bun scripts/studio-auth-check.ts",
    "test:studio-ui": "bun scripts/studio-ui-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@better-auth/passkey": "1.7.7",
    "@electric-sql/pglite": "0.5.10",
    "@elysiajs/cors": "1.4.2",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "@tanstack/store": "0.11.2",
    "@types/bun": "1.4.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.8.6",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "commander": "15.0.0",
    "dagre": "^0.8.5",
    "elysia": "1.4.30",
    "github-slugger": "2.0.0",
    "graphql": "17.0.2",
    "graphql-yoga": "5.24.2",
    "kysely": "0.29.6",
    "lucide-react": "1.52.0",
    "minisearch": "7.2.0",
    "nodemailer": "10.0.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-flow-auto-layout": "^0.2.0",
    "react-test-renderer": "19.3.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "resend": "6.32.0",
    "shiki": "4.5.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "prettier": "3.9.9"
  }
}
