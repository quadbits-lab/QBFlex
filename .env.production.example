# QB Flex production environment for compose.selfhost.yml.
# Copy to .env (or .env.production) on the deployment host and replace every placeholder.
# Never commit the completed file: it is git-ignored via the .env.* pattern.

# --- Public domains (required) ---
# Caddy issues Let's Encrypt certificates; DNS must resolve to the host first.
QB_API_DOMAIN=api.example.com
QB_STUDIO_DOMAIN=studio.example.com
QB_DOCS_DOMAIN=docs.example.com
# Exact additional browser origins allowed to call the API (comma separated, no trailing slash).
QB_APP_ORIGINS=https://app.example.com

# --- Secrets (required) ---
# Generate with: openssl rand -hex 32  (master key must be at least 32 characters).
# Keep QB_MASTER_KEY backed up offline; without it encrypted snapshots cannot be restored.
QB_MASTER_KEY=replace_with_openssl_rand_hex_32
# One-time first-owner bootstrap token; delete it from the host after initial setup.
QB_BOOTSTRAP_TOKEN=replace_with_openssl_rand_hex_32
# Private bearer token shared with the worker service; keep it off the public internet.
QB_WORKER_TOKEN=replace_with_openssl_rand_hex_32

# --- Object storage (required: any S3-compatible provider) ---
# Examples: RustFS (default S3 port 9000), MinIO CE, AWS S3, Cloudflare R2.
# The endpoint must be reachable from the Compose container network — for a
# host-local backend use http://host.docker.internal:9000; on Linux hosts add
# extra_hosts: ["host.docker.internal:host-gateway"] to the service in compose.
QB_S3_ENDPOINT=http://host.docker.internal:9000
QB_S3_REGION=us-east-1
QB_S3_BUCKET=qb-flex
QB_S3_ACCESS_KEY=replace_with_s3_access_key
QB_S3_SECRET_KEY=replace_with_s3_secret_key

# --- Email (Resend is the primary provider; SMTP is the optional fallback) ---
# Auth email (verification, password reset) renders React Email templates and ships through
# Resend. Create an API key at https://resend.com/dashboard/api-keys and verify the sending
# domain. Production refuses to start without QB_RESEND_API_KEY or QB_SMTP_HOST.
QB_RESEND_API_KEY=replace_with_resend_api_key
# Optional SMTP fallback for operators preferring their own relay. Ignored when
# QB_RESEND_API_KEY is set.
# QB_SMTP_HOST=
# QB_SMTP_PORT=587
# QB_SMTP_USER=
# QB_SMTP_PASSWORD=
QB_MAIL_FROM=QB Flex <hello@example.com>

# --- Optional tuning (safe defaults) ---
# Per-service CPU/memory limits and log rotation are set in compose.selfhost.yml.
# Override any of them here, for example:
# QB_API_MEMORY=8g
# QB_WORKER_MEMORY=1g
# QB_API_CPUS=2.0
# Optional reviewed private webhook receivers; exact HTTPS origins -> fixed IPs.
# Default empty: public HTTPS only; no TLS bypass or metadata destinations.
# QB_WEBHOOK_INTERNAL_ALLOWLIST={"https://receiver.internal:8443":["10.20.0.5"]}

# PGlite owner admission limit (1..32); size memory for control + active branch instances.
QB_MAX_BRANCH_OWNERS=4

# Terminal output: auto | pretty | json. JSON is automatic for production and pipes.
QB_LOG_FORMAT=json
# Include routine successful internal polling in pretty output.
QB_LOG_INTERNAL=false
