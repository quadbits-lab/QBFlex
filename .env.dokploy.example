# QB Flex environment for single-file Compose deployments (Dokploy, Coolify, Portainer,
# or a plain Docker host using compose.yml without the self-host gateway overlay).
#
# In Dokploy, paste these keys into the application's Environment tab. Dokploy writes
# them to .env next to the compose file, and compose.yml interpolates ${VAR} references.
# Never commit the completed file.

# --- Runtime mode (required) ---
# Production enforces HTTPS public URLs, operator-provided secrets and admin MFA.
NODE_ENV=production

# --- Public HTTPS URLs (required) ---
# The API rejects a non-HTTPS QB_PUBLIC_URL in production unless the host is loopback
# and QB_ALLOW_INSECURE_HTTP=true (local staging only).
QB_PUBLIC_URL=https://api.example.com
QB_STUDIO_URL=https://studio.example.com
QB_DOCS_URL=https://docs.example.com
# Exact browser origins allowed to call the API (comma separated, no wildcards or
# trailing slashes). Include the Studio origin and any application origins.
QB_ALLOWED_ORIGINS=https://studio.example.com
# Studio and Docs bake these into the browser build at image build time. Change them
# together with the URLs above and rebuild/redeploy; runtime changes alone do not apply.
VITE_API_URL=https://api.example.com
VITE_STUDIO_URL=https://studio.example.com
VITE_DOCS_URL=https://docs.example.com

# --- Secrets (required) ---
# Generate with: openssl rand -hex 32  (master key must be at least 32 characters).
# Keep QB_MASTER_KEY backed up offline; without it encrypted snapshots cannot be restored.
QB_MASTER_KEY=replace_with_openssl_rand_hex_32
# One-time first-owner bootstrap token; remove it from the platform after initial setup.
QB_BOOTSTRAP_TOKEN=replace_with_openssl_rand_hex_32
# Private bearer token shared with the worker service; never expose it publicly.
QB_WORKER_TOKEN=replace_with_openssl_rand_hex_32
# Public deployments should require admin MFA.
QB_REQUIRE_ADMIN_MFA=true

# --- Object storage (required: any S3-compatible provider) ---
# The endpoint must be reachable from the Compose containers. Use a public HTTPS
# endpoint, or http://host.docker.internal:9000 for a host-local backend.
QB_S3_ENDPOINT=https://s3.example.com
QB_S3_REGION=us-east-1
QB_S3_BUCKET=qb-flex
QB_S3_ACCESS_KEY=replace_with_s3_access_key
QB_S3_SECRET_KEY=replace_with_s3_secret_key

# --- Email (required in production: Resend or SMTP) ---
QB_MAIL_PROVIDER=resend
QB_RESEND_API_KEY=replace_with_resend_api_key
QB_MAIL_FROM=QB Flex <hello@example.com>
# Optional SMTP fallback instead of Resend. Ignored when a Resend key is set.
# QB_MAIL_PROVIDER=smtp
# QB_SMTP_HOST=smtp.example.com
# QB_SMTP_PORT=587
# QB_SMTP_USER=
# QB_SMTP_PASSWORD=
# QB_SMTP_SECURE=false

# --- Optional tuning ---
# Bind address and host ports for published API/Studio/Docs ports. Keep loopback
# when the platform proxy (for example Dokploy's Traefik) reaches containers over the
# Docker network; set 0.0.0.0 only when the proxy connects through host-published ports.
# Change the host ports if the server already uses 7612/7610/7611; container ports and
# platform proxy targets stay 7612/7610/7611.
# QB_BIND_ADDRESS=127.0.0.1
# QB_API_PORT=7612
# QB_STUDIO_PORT=7610
# QB_DOCS_PORT=7611
QB_MAX_BRANCH_OWNERS=4
QB_LOG_FORMAT=json
QB_LOG_INTERNAL=false
# Optional reviewed private webhook receivers; exact HTTPS origins -> fixed IPs.
# QB_WEBHOOK_INTERNAL_ALLOWLIST={"https://receiver.internal:8443":["10.20.0.5"]}
# Optional Studio assistant (OpenAI-compatible, public HTTPS only).
# QB_AI_BASE_URL=https://api.openai.com/v1
# QB_AI_API_KEY=
# QB_AI_MODEL=
