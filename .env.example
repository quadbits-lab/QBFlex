QB_MODE=local
QB_PUBLIC_URL=http://localhost:7612
QB_STUDIO_URL=http://localhost:7610
QB_DOCS_URL=http://localhost:7611
QB_ALLOWED_ORIGINS=http://localhost:7610,http://127.0.0.1:7610,http://localhost:7617,http://127.0.0.1:7617,http://localhost:7618,http://127.0.0.1:7618
QB_REGION=local
# Object storage: any S3-compatible provider works (RustFS, MinIO CE, AWS S3, R2, ...).
# Local example below assumes RustFS serving S3 at its default port 9000.
QB_S3_ENDPOINT=http://127.0.0.1:9000
QB_S3_REGION=us-east-1
QB_S3_BUCKET=qb-flex
QB_S3_ACCESS_KEY=replace_with_storage_access_key
QB_S3_SECRET_KEY=replace_with_storage_secret_key
# Primary email provider: Resend (https://resend.com) delivers React Email templates.
# QB_MAIL_PROVIDER: 'resend' | 'smtp' | 'auto' (default auto = Resend when a key exists).
# Set 'smtp' to keep Mailpit local delivery while a Resend key is present.
QB_MAIL_PROVIDER=smtp
QB_RESEND_API_KEY=
QB_SMTP_HOST=127.0.0.1
QB_SMTP_PORT=7615
# Set QB_SMTP_SECURE=true for implicit-TLS relays (e.g. Resend SMTP on port 465).
# QB_SMTP_SECURE=true
QB_MAIL_FROM=QB Flex <hello@localhost>
QB_BACKUP_RETENTION_DAYS=7
QB_BACKUP_RETENTION_WEEKS=4
QB_REQUIRE_ADMIN_MFA=false
VITE_API_URL=http://localhost:7612
VITE_DOCS_URL=http://localhost:7611
VITE_STUDIO_URL=http://localhost:7610
# Production must inject QB_MASTER_KEY, QB_BOOTSTRAP_TOKEN and QB_WORKER_TOKEN.
# Local-only secrets are generated under .data with mode 0600 on first startup.

# Experimental job executor principal only. Full push delivery remains planned.
QB_PUSH_ENABLED=false
# Required only when explicitly enabling the principal; distinct from QB_WORKER_TOKEN.
QB_PUSH_WORKER_TOKEN=
# Webhooks: default public HTTPS only. Optional exact origins -> fixed IPs (JSON).
# Configure the same allowlist on API and worker. Never allow metadata endpoints.
QB_WEBHOOK_INTERNAL_ALLOWLIST=

# PGlite owner admission limit (1..32); size memory for control + active branch instances.
QB_MAX_BRANCH_OWNERS=4

# Terminal output: auto | pretty | json. JSON is automatic for production and pipes.
QB_LOG_FORMAT=auto
# Include routine successful internal polling in pretty output.
QB_LOG_INTERNAL=false
QB_DATA_DIR="$PWD/.data-pglite"